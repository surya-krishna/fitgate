# FitGate LLM provider configuration
#
# Copy this file to `.env` and fill in the key(s) for whichever provider(s)
# you want to use. Providers are tried in this order, and any provider whose
# key is missing is skipped: openrouter -> gemini -> openai.
#
# Never commit your real .env file — it's already excluded via .gitignore.

# --- OpenRouter (tried first) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Used for OpenRouter's HTTP-Referer header (optional)
FITGATE_PUBLIC_URL=https://github.com/fitgate/fitgate

# --- Google Gemini (OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
