{
  "name": "fitgate-oss",
  "private": true,
  "version": "0.1.0",
  "description": "FitGate — gate your coding agent's human-in-the-loop approvals behind micro-workouts. Make programmers fit.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.10" },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r build",
    "dev:cli": "pnpm --filter fitgate dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
